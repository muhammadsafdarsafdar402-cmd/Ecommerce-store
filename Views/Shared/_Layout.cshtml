<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - MyStore</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
  <nav class="navbar navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" asp-controller="Products" asp-action="Index">MyStore</a>
      <a class="btn btn-outline-light" asp-controller="Cart" asp-action="Index">Cart</a>
    </div>
  </nav>
  <main class="container py-4">@RenderBody()</main>
  <footer class="text-center text-muted small py-4">&copy; 2026 MyStore - demo e-commerce project</footer>
</body>
</html>
