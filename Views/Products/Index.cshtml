@model List<Product>
@{ ViewData["Title"] = "Products"; }
<form method="get" class="row g-2 mb-4">
  <div class="col-md-6"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Search products" /></div>
  <div class="col-md-4">
    <select name="category" class="form-select">
      <option value="">All categories</option>
      @foreach (var c in (List<string>)ViewBag.Categories)
      {
        <option value="@c" selected="@(c == (string?)ViewBag.Category)">@c</option>
      }
    </select>
  </div>
  <div class="col-md-2"><button class="btn btn-dark w-100">Search</button></div>
</form>
@if (!Model.Any()) { <p>No products found.</p> }
<div class="row g-4">
  @foreach (var p in Model)
  {
    <div class="col-sm-6 col-lg-4">
      <div class="card h-100 shadow-sm">
        <div class="ph">@p.Name[0]</div>
        <div class="card-body d-flex flex-column">
          <h5>@p.Name</h5>
          <p class="text-muted small mb-1">@p.Category</p>
          <p class="fw-bold">Rs. @p.Price.ToString("N0")</p>
          <div class="mt-auto d-flex gap-2">
            <a class="btn btn-outline-dark" asp-action="Details" asp-route-id="@p.Id">Details</a>
            <form asp-controller="Cart" asp-action="Add" asp-route-id="@p.Id" method="post">
              <button class="btn btn-dark" disabled="@(p.Stock < 1)">Add to cart</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  }
</div>
